# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
APP_LOCALE=uk
NODE_ENV=development

# PostgreSQL (required for persistent production data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drivestate

# Apibara Vehicle Auction Data API — server only, never NEXT_PUBLIC_
APIBARA_API_KEY=
APIBARA_BASE_URL=https://apibara.tech/api/v1/vehicle-auction
APIBARA_REQUEST_TIMEOUT_MS=45000
AUCTION_SYNC_MODE=free
AUCTION_SYNC_PER_PAGE=20
# Two FREE-mode runs per day: request recently changed active lots instead of
# downloading the same first page repeatedly.
AUCTION_SYNC_UPDATED_WITHIN_MINUTES=720
MOCK_AUCTION_MODE=true

# Scheduled sync endpoint
CRON_SECRET=replace-with-a-long-random-secret

# Admin authentication
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-before-seeding

# Telegram lead delivery (optional)
TELEGRAM_BOT_TOKEN=
# 32 random bytes encoded as 64 hex characters. Used to encrypt integration tokens stored from /admin.
INTEGRATION_SECRETS_KEY=
TELEGRAM_CHAT_ID=

# Social autopublishing (all server-only)
TELEGRAM_CHANNEL_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Set this once as the official Instagram profile bio link.
INSTAGRAM_BIO_URL=http://localhost:3000/instagram
VIBER_BOT_TOKEN=
VIBER_BROADCAST_LIST=
VIBER_SENDER_NAME=DRIVE STATE
AUTOPOST_MODE=manual
TIMEZONE=Europe/Kyiv

# Google Analytics 4 and Google Ads (can also be managed in /admin/google)
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_CONVERSION_LABEL=
GOOGLE_ADS_PHONE_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
